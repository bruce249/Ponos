# Byline Work. Testnet only. Copy to .env. Never commit .env.
# Hedera keys are demo custody: the server holds them and the UI says so.

HEDERA_NETWORK=hedera:testnet
HEDERA_JSON_RPC=https://testnet.hashio.io/api
# Operator from https://portal.hedera.com. Pays setup and submits HCS. Also the x402 payee.
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=

HCS_TOPIC_ID=
# Blocky402, or "local" to settle in-process with the operator key.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Stablecoin Studio deployment (not a token id). The create script prints BUSD_* after a real create.
SCS_FACTORY_ADDRESS=
SCS_RESOLVER_ADDRESS=
# Optional. Defaults are the SDK's CONFIG_SC / CONFIG_RESERVE / version 1.
# SCS_CONFIG_ID=
# SCS_CONFIG_VERSION=1
# SCS_RESERVE_CONFIG_ID=
# SCS_RESERVE_CONFIG_VERSION=1
BUSD_TOKEN_ID=
BUSD_SCS_PROXY=
BUSD_RESERVE_ADDRESS=
BUSD_TOKEN_EVM=

ESCROW_CONTRACT_ID=
ESCROW_ADDRESS=
# hip1215 (inside the contract) | sdk (ScheduleCreate waitForExpiry) | keeper
ESCROW_SCHEDULING=hip1215
HITL_THRESHOLD=100
# Above this (whole bUSD), approve needs two different reviewers on-chain. 0 turns it off. Set at deploy.
DUAL_REVIEW_THRESHOLD=1000
PLATFORM_FEE_BPS=300
QA_POOL_SHARE_BPS=3333
MIN_WINDOW_SEC=120
MAX_WINDOW_SEC=2592000
DISPUTE_WINDOW_SEC=600
KEEPER_INTERVAL_SEC=15
INDEXER_INTERVAL_SEC=3
HBAR_LOW_TINYBAR=500000000

# EIP-191 key for x402 responses. npm run keys
FEED_SIGNER_KEY=
# Public FX source. Responses are labelled with this provider's name.
FX_API_URL=https://open.er-api.com/v6/latest/USD
PRICE_RESERVE_TINYBAR=100000
PRICE_STATS_TINYBAR=500000

# World ID. One worker per (iss, sub). The subject never leaves the database.
WORLD_ISSUER=https://auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_REDIRECT_URI=http://localhost:3000/api/world/callback
WORLD_STEPUP_MAX_AGE_SEC=120
WORLD_APPROVAL_TTL_SEC=120
WORLD_REQUIRE_ACR=1
# WORLD_ACR_VALUES=
# Creates POST /api/demo/worker, labelled "demo human". Not a World ID.
DEMO_MOCK_WORLD=0

# 0G rubric note. Leave empty to skip. teeVerified is never forced on.
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_MODEL=0gm-1.0-35b-a3b
ZG_TRUST_MODE=private
ZG_DISABLE_THINKING=1

DAILY_CLAIM_CAP=10
IN_FLIGHT_CAP_NEW=2

PORT=8787
API_PUBLIC_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:3000
DB_PATH=data/byline-work.db
SESSION_SECURE=0

# Role accounts. npm run keys fills the keys, npm run accounts creates the accounts. ECDSA, EVM alias, max auto-association.
# <ROLE>_ACCOUNT_ID and <ROLE>_PRIVATE_KEY
SCS_ADMIN_ACCOUNT_ID=
SCS_ADMIN_PRIVATE_KEY=
CASHIN_ACCOUNT_ID=
CASHIN_PRIVATE_KEY=
BURN_ACCOUNT_ID=
BURN_PRIVATE_KEY=
COMPLIANCE_ACCOUNT_ID=
COMPLIANCE_PRIVATE_KEY=
TREASURY_ACCOUNT_ID=
TREASURY_PRIVATE_KEY=
QA_POOL_ACCOUNT_ID=
QA_POOL_PRIVATE_KEY=
ESCROW_ADMIN_ACCOUNT_ID=
ESCROW_ADMIN_PRIVATE_KEY=
BACKEND_ACCOUNT_ID=
BACKEND_PRIVATE_KEY=
QA_ORACLE_ACCOUNT_ID=
QA_ORACLE_PRIVATE_KEY=
REVIEWER_ACCOUNT_ID=
REVIEWER_PRIVATE_KEY=
# Second reviewer for the dual-review tier (DUAL_REVIEW_THRESHOLD).
REVIEWER_B_ACCOUNT_ID=
REVIEWER_B_PRIVATE_KEY=
LAB_ACCOUNT_ID=
LAB_PRIVATE_KEY=
WORKER_A_ACCOUNT_ID=
WORKER_A_PRIVATE_KEY=
WORKER_B_ACCOUNT_ID=
WORKER_B_PRIVATE_KEY=
WORKER_RENTED_ACCOUNT_ID=
WORKER_RENTED_PRIVATE_KEY=
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# Optional comma lists. Empty means the single LAB_ACCOUNT_ID / REVIEWER_ACCOUNT_ID.
LAB_ALLOWLIST=
REVIEWER_ALLOWLIST=
