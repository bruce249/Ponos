{
  "name": "byline-work",
  "version": "0.1.0",
  "private": true,
  "description": "Escrowed human work paid in bUSD. Stablecoin Studio, a scheduled escrow, and an x402 data service on Hedera testnet.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "vendor/*"
  ],
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env apps/api/src/index.ts",
    "start:api": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "fund": "tsx --env-file-if-exists=.env scripts/fund.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "keys": "tsx scripts/gen-keys.ts",
    "accounts": "tsx --env-file-if-exists=.env scripts/create-accounts.ts",
    "topic": "tsx --env-file-if-exists=.env scripts/create-topic.ts",
    "busd": "tsx --env-file-if-exists=.env stablecoin/create-busd.ts",
    "busd:fee": "tsx --env-file-if-exists=.env stablecoin/fee.ts",
    "lifecycle": "tsx --env-file-if-exists=.env stablecoin/lifecycle.ts",
    "deploy:escrow": "tsx --env-file-if-exists=.env scripts/deploy-escrow.ts",
    "demo-seed": "tsx --env-file-if-exists=.env scripts/demo-seed.ts",
    "demo:frozen-transfer": "tsx --env-file-if-exists=.env scripts/frozen-transfer.ts",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts",
    "buy-nav": "tsx --env-file-if-exists=.env scripts/buy-nav.ts",
    "score": "tsx --env-file-if-exists=.env scripts/score.ts",
    "test": "tsx --test packages/shared/test/*.test.ts apps/api/test/*.test.ts",
    "dev:web": "npm run dev -w @byline/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p scripts && npm run typecheck -w @byline/web"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
